{
  "name": "@digitalcredentials/did-method-web",
  "version": "1.0.3-beta.1",
  "description": "A did:web method resolver.",
  "homepage": "https://github.com/digitalcredentials/did-method-web",
  "repository": {
    "type": "git",
    "url": "https://github.com/digitalcredentials/did-method-web"
  },
  "bugs": {
    "url": "https://github.com/digitalcredentials/did-method-web/issues"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "rollup.config.js",
    "build-dist.sh",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@digitalcredentials/did-io": "^2.0.0",
    "@digitalcredentials/did-method-key": "^5.2.0",
    "@digitalcredentials/http-client": "^4.0.0",
    "klona": "^2.0.6"
  },
  "devDependencies": {
    "@digitalbazaar/bls12-381-multikey": "^1.1.1",
    "@digitalbazaar/ecdsa-multikey": "^1.6.0",
    "@digitalbazaar/ed25519-signature-2020": "^5.0.0",
    "@digitalbazaar/ed25519-verification-key-2018": "^4.0.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.0.0",
    "@digitalbazaar/vc": "^6.2.0",
    "@digitalbazaar/x25519-key-agreement-key-2019": "^6.0.0",
    "@digitalbazaar/x25519-key-agreement-key-2020": "^3.0.0",
    "c8": "^9.1.0",
    "chai": "^4.3.6",
    "cross-env": "^7.0.3",
    "eslint": "^8.16.0",
    "eslint-config-digitalbazaar": "^5.0.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^48.0.2",
    "eslint-plugin-unicorn": "^52.0.0",
    "karma": "^6.3.20",
    "karma-babel-preprocessor": "^8.0.2",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "^3.1.1",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-webpack": "^5.0.0",
    "mocha": "^10.0.0",
    "mocha-lcov-reporter": "^1.3.0",
    "sinon": "^15.0.0",
    "webpack": "^5.73.0"
  },
  "c8": {
    "reporter": [
      "lcov",
      "text-summary",
      "text"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "Decentralized",
    "Identifier",
    "DID"
  ],
  "scripts": {
    "rollup": "rollup -c rollup.config.js",
    "build": "npm run clear && npm run rollup && ./build-dist.sh",
    "clear": "rimraf dist/ && mkdir dist",
    "posttest": "node post-test.js",
    "prepare": "npm run build",
    "pretest": "node pre-test.js",
    "rebuild": "npm run clear && npm run build",
    "test": "npm run test-node",
    "test-node": "cross-env NODE_ENV=test mocha --preserve-symlinks -t 10000 test/*.spec.js",
    "test-karma": "karma start karma.conf.cjs",
    "lint": "eslint 'lib/**/*.js' 'test/**/*.js'",
    "coverage": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text-summary npm run test-node",
    "coverage-ci": "cross-env NODE_ENV=test nyc --reporter=lcovonly npm run test-node",
    "coverage-report": "nyc report"
  }




}
